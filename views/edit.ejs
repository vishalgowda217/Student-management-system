<!DOCTYPE html>
<html>
<head>
    <title>Edit Student</title>

    <style>
        body {
            font-family: Arial;
            background: #eef2f7;
            padding: 40px;
        }

        .box {
            width: 450px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        h1 {
            text-align: center;
            color: #1e3a8a;
        }

        input {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            box-sizing: border-box;
        }

        button {
            width: 100%;
            padding: 12px;
            background: #16a34a;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        .back {
            display: block;
            text-align: center;
            margin-top: 15px;
        }
    </style>
</head>

<body>

<div class="box">

    <h1>✏️ Edit Student</h1>

    <form action="/edit/<%= student.id %>" method="POST">

        <input
            type="text"
            name="name"
            value="<%= student.name %>"
            required
        >

        <input
            type="email"
            name="email"
            value="<%= student.email %>"
            required
        >

        <input
            type="text"
            name="course"
            value="<%= student.course %>"
            required
        >

        <input
            type="number"
            name="marks"
            value="<%= student.marks %>"
            required
        >

        <button type="submit">
            Update Student
        </button>

    </form>

    <a class="back" href="/">
        ← Back to Students
    </a>

</div>

</body>
</html>