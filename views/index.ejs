<!DOCTYPE html>
<html>

<head>

    <title>Student Management System</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #eef2f7;
            margin: 0;
            padding: 40px;
        }

        .container {
            width: 95%;
            max-width: 1100px;
            margin: auto;
            background: white;
            padding: 35px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        h1 {
            text-align: center;
            color: #1e3a8a;
            margin-bottom: 30px;
        }

        h2 {
            color: #1e3a8a;
            margin-top: 30px;
        }

        /* =========================
           SEARCH
        ========================= */

        .search-box {
            text-align: center;
            margin-bottom: 30px;
        }

        .search-box input {
            width: 320px;
            padding: 13px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            font-size: 15px;
        }

        .search-btn {
            padding: 13px 20px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 7px;
            cursor: pointer;
            font-size: 15px;
            margin-left: 5px;
        }

        .search-btn:hover {
            background: #1d4ed8;
        }

        .show-all {
            display: inline-block;
            padding: 13px 20px;
            background: #64748b;
            color: white;
            text-decoration: none;
            border-radius: 7px;
            margin-left: 5px;
        }

        .show-all:hover {
            background: #475569;
        }

        /* =========================
           TABLE
        ========================= */

        .table-container {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 850px;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th {
            background: #1e3a8a;
            color: white;
            padding: 14px;
            text-align: center;
        }

        td {
            padding: 14px;
            text-align: center;
            border-bottom: 1px solid #e2e8f0;
        }

        tr:hover {
            background: #f8fafc;
        }

        /* =========================
           ACTION BUTTONS
        ========================= */

        .actions {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        .edit {
            display: inline-block;
            background: #16a34a;
            color: white;
            padding: 9px 14px;
            text-decoration: none;
            border-radius: 6px;
            font-size: 14px;
            white-space: nowrap;
        }

        .edit:hover {
            background: #15803d;
        }

        .delete {
            display: inline-block;
            background: #dc2626;
            color: white;
            padding: 9px 14px;
            text-decoration: none;
            border-radius: 6px;
            font-size: 14px;
            white-space: nowrap;
            margin-left: 0;
        }

        .delete:hover {
            background: #b91c1c;
        }

        /* =========================
           ADD BUTTON
        ========================= */

        .add {
            display: inline-block;
            margin-top: 25px;
            background: #2563eb;
            color: white;
            padding: 13px 22px;
            text-decoration: none;
            border-radius: 7px;
        }

        .add:hover {
            background: #1d4ed8;
        }

        /* =========================
           NOT FOUND
        ========================= */

        .not-found {
            text-align: center;
            background: #fee2e2;
            color: #b91c1c;
            padding: 20px;
            border-radius: 8px;
            margin-top: 20px;
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 700px) {

            body {
                padding: 15px;
            }

            .container {
                width: 100%;
                padding: 20px;
            }

            .search-box input {
                width: 100%;
                margin-bottom: 10px;
            }

            .search-btn,
            .show-all {
                margin: 3px;
            }

            .actions {
                flex-direction: row;
            }

        }

    </style>

</head>

<body>

<div class="container">

    <h1>🎓 Student Management System</h1>


    <!-- SEARCH -->

    <div class="search-box">

        <form action="/" method="GET">

            <input
                type="text"
                name="search"
                placeholder="Enter Student Name or ID"
                required
            >

            <button
                type="submit"
                class="search-btn">

                🔍 Search

            </button>

            <a
                href="/"
                class="show-all">

                Show All

            </a>

        </form>

    </div>


    <!-- SEARCH RESULT -->

    <% if (searchedStudent) { %>

        <h2>🔎 Search Result</h2>

        <div class="table-container">

            <table>

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Course</th>
                        <th>Marks</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>
                            <%= searchedStudent.id %>
                        </td>

                        <td>
                            <%= searchedStudent.name %>
                        </td>

                        <td>
                            <%= searchedStudent.email %>
                        </td>

                        <td>
                            <%= searchedStudent.course %>
                        </td>

                        <td>
                            <%= searchedStudent.marks %>
                        </td>

                        <td>

                            <div class="actions">

                                <a
                                    href="/edit/<%= searchedStudent.id %>"
                                    class="edit">

                                    ✏️ Edit

                                </a>

                                <a
                                    href="/delete/<%= searchedStudent.id %>"
                                    class="delete"
                                    onclick="return confirm('Delete this student?')">

                                    🗑️ Delete

                                </a>

                            </div>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>


    <% } else if (searchPerformed) { %>


        <!-- NOT FOUND -->

        <div class="not-found">

            ❌ Student not found!

        </div>


    <% } else { %>


        <!-- ALL STUDENTS -->

        <h2>👨‍🎓 All Students</h2>

        <div class="table-container">

            <table>

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Course</th>
                        <th>Marks</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    <% students.forEach(student => { %>

                        <tr>

                            <td>
                                <%= student.id %>
                            </td>

                            <td>
                                <%= student.name %>
                            </td>

                            <td>
                                <%= student.email %>
                            </td>

                            <td>
                                <%= student.course %>
                            </td>

                            <td>
                                <%= student.marks %>
                            </td>

                            <td>

                                <div class="actions">

                                    <a
                                        href="/edit/<%= student.id %>"
                                        class="edit">

                                        ✏️ Edit

                                    </a>

                                    <a
                                        href="/delete/<%= student.id %>"
                                        class="delete"
                                        onclick="return confirm('Delete this student?')">

                                        🗑️ Delete

                                    </a>

                                </div>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>


    <% } %>


    <!-- ADD STUDENT -->

    <a
        href="/add"
        class="add">

        ➕ Add Student

    </a>

</div>

</body>

</html>